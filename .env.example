# Copy to .env and fill locally. Do not share the bot credential in chat.
BOT_AUTH=
GUILD_ID=
CHANNEL_ID=
TIMEZONE=America/Chicago
POST_TIME=19:00
# Local SQLite is used by default. Cloud: link the free PostgreSQL addon URI
# privately as DATABASE_URL; do not put credentials in this file or Git.
DATABASE_URL=
REQUIRE_POSTGRES=false
